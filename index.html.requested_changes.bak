<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>سامانه یکپارچه لینک های رادیویی</title>
<style>
:root{--bg:#0b1220;--card:#142033;--muted:#8fa1b8;--line:#263850;--accent:#2f81f7;--ok:#34d399;--bad:#fb7185;--warn:#fbbf24}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#eef4fb;font-family:Tahoma,Arial,sans-serif}.wrap{max-width:1600px;margin:auto;padding:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px}.header{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;color:#0b1220}.brand{display:flex;align-items:center;justify-content:center;gap:12px;flex:1}.brand h1{font-size:22px;margin:0}.logo{height:52px;width:auto;object-fit:contain}.toolbar,.tabs,.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.city{cursor:pointer;transition:.15s}.city:hover{transform:translateY(-2px);border-color:var(--accent)}.city h2{margin:4px 0}.muted{color:var(--muted)}.btn,input,select,textarea{border:1px solid #3a506e;border-radius:9px;background:#0c1728;color:#eef4fb;padding:9px 11px}.btn{cursor:pointer}.primary{background:#246bf3;border-color:#246bf3}.danger{background:#9f1d35;border-color:#9f1d35}.success{background:#116b50;border-color:#116b50}.tab{padding:9px 12px;border:1px solid #3a506e;border-radius:9px;background:#0c1728;cursor:pointer}.tab.active{background:var(--accent)}.table{overflow:auto}.table table{width:100%;border-collapse:collapse;min-width:900px}.table th,.table td{padding:7px 8px;border-bottom:1px solid var(--line);font-size:12px;white-space:nowrap;text-align:right}.table th{position:sticky;top:0;background:#101c2d}.ltr{direction:ltr;text-align:left!important}.kpi{font-size:30px;font-weight:700}.status{padding:8px 10px;border-radius:8px;background:#0c1728}.ok{color:var(--ok)}.bad{color:var(--bad)}.warn{color:var(--warn)}.pill{display:inline-block;padding:3px 7px;border-radius:99px;background:#223652;margin:2px;font-size:11px}.raw{white-space:pre-wrap;word-break:break-word;background:#09111d;border-radius:9px;padding:10px;max-height:440px;overflow:auto;direction:ltr;text-align:left}.section-title{display:flex;justify-content:space-between;align-items:center;gap:8px}.small{font-size:12px}.checkboxes{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:7px}.check{border:1px solid var(--line);padding:8px;border-radius:9px;background:#0e1929}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.field{display:flex;flex-direction:column;gap:5px}.wide{grid-column:1/-1}.hidden{display:none}.notice{padding:10px;border-radius:10px;background:#10233a}.manual{border:1px dashed #406188;background:#101e30}.top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.link{color:#6db2ff;cursor:pointer}.right{text-align:right}.center{text-align:center}
</style></head><body><div class="wrap" id="app"></div>
<script>
const API=location.protocol==='file:'?'http://localhost:5000':location.origin;let AUTH='',ME=null,current=null,currentCity=null,lastScanId=null;
const $=id=>document.getElementById(id);const h=s=>{const d=document.createElement('div');d.textContent=s??'';return d.innerHTML||'-'};
async function api(url,opt={}){opt.headers=Object.assign({'Authorization':AUTH,'Content-Type':'application/json'},opt.headers||{});const r=await fetch(API+url,opt);if(r.status===401)throw new Error('auth');let j={};try{j=await r.json()}catch{}if(!r.ok)throw new Error(j.message||j.error||`HTTP ${r.status}`);return j}
async function fileDownload(url,name){const r=await fetch(API+url,{headers:{Authorization:AUTH}});if(!r.ok){let j={};try{j=await r.json()}catch{}throw new Error(j.message||j.error||`HTTP ${r.status}`)}const b=await r.blob();const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function login(){app.innerHTML=`<div class="card" style="max-width:420px;margin:10vh auto"><h2>ورود به سامانه</h2><div class="field"><label>نام کاربری</label><input id="u"></div><br><div class="field"><label>رمز عبور</label><input id="p" type="password"></div><br><button class="btn primary" onclick="doLogin()">ورود</button></div>`;u.focus()}
async function doLogin(){const u=$('u').value.trim(),p=$('p').value;if(!u||!p)return alert('نام کاربری و رمز عبور را وارد کنید');AUTH='Basic '+btoa(u+':'+p);try{ME=await api('/api/me');loadHome()}catch(e){AUTH='';ME=null;alert('نام کاربری یا رمز عبور اشتباه است')}}
async function logout(){try{await api('/api/logout',{method:'POST',body:'{}'})}catch{}AUTH='';ME=null;current=null;login()}
function nav(){return `<div class="card"><div class="top-actions"><button class="btn" onclick="loadHome()">🏠 داشبورد</button><button class="btn" onclick="openViewExcel()">📊 Excel</button>${ME.role==='full'?`<button class="btn" onclick="openAdmin()">⚙ مدیریت</button><button class="btn" onclick="openScanIPs(lastScanId)">📋 IPهای اسکن شده</button>`:''}<button class="btn" onclick="loadHome()">🔄 بروزرسانی</button><button class="btn danger" onclick="logout()">خروج</button></div></div>`}
async function loadHome(){app.innerHTML=nav()+`<div class="card"><div class="loading">در حال دریافت اطلاعات...</div></div>`;try{let [st,cities]=await Promise.all([api('/api/stats'),api('/api/cities')]);lastScanId=st.last_scan?.id||null;cities=cities.map(c=>Object.assign({},c,(st.cities||[]).find(x=>String(x.id)===String(c.id))||{}));app.innerHTML=nav()+`<div class="card header"><div class="brand"><img src="/images/sazman.png" class="logo" onerror="this.style.display='none'"><h1>📡 سامانه یکپارچه لینک های رادیویی</h1><img src="/images/sabanet.png" class="logo" onerror="this.style.display='none'"></div><div class="small">کاربر: <b>${h(ME.username)}</b></div></div><div class="grid"><div class="card"><div class="muted">کل دستگاه‌ها</div><div class="kpi">${st.total_devices||0}</div></div><div class="card"><div class="muted">آنلاین</div><div class="kpi ok">${st.online_devices||0}</div></div>${st.last_scan?`<div class="card"><div class="muted">آخرین اسکن</div><div>${h(st.last_scan.scan_time)}</div><div class="small">کل IP: ${st.last_scan.total_ips_scanned} | موفق: ${st.last_scan.devices_success} | رد/غیرفعال: ${st.last_scan.devices_skipped} | خطا: ${st.last_scan.devices_failed}</div>${ME.role==='full'?`<button class="btn" onclick="openScanIPs(${st.last_scan.id})">مشاهده IPهای همین اسکن</button>`:''}</div>`:''}</div>${ME.role==='full'?scanPanel(cities):''}<div class="card"><div class="section-title"><h3>🏞 آمار استان‌ها</h3><span class="muted">تعداد آنتن‌های ثبت‌شده و آنلاین</span></div><div class="grid">${(st.provinces||[]).map(p=>`<div class="card"><h3>${h(p.province||'نامشخص')}</h3><div>کل آنتن: <b>${p.total||0}</b> &nbsp; آنلاین: <b class="ok">${p.online||0}</b></div></div>`).join('')}</div></div><div class="card"><div class="section-title"><h3>🏙 شهرها</h3><span class="muted">IPها در این صفحه نمایش داده نمی‌شوند؛ روی شهر کلیک کنید.</span></div><div class="grid">${cities.filter(c=>c.enabled).map(c=>`<div class="card city" onclick="openCity(${c.id})"><div class="muted">${h(c.cidr)}</div><h2>${h(c.name)}</h2><div>کل: <b>${c.total||0}</b> &nbsp; آنلاین: <b class="ok">${c.online||0}</b></div></div>`).join('')}</div></div>`; }catch(e){if(e.message==='auth'){AUTH='';ME=null;return login()}app.innerHTML=nav()+`<div class="card bad">خطا: ${h(e.message)}</div>`}}
function scanPanel(cities){return `<div class="card"><div class="section-title"><h3>🔎 اسکن شهرها</h3><span class="muted">SNMP + RouterOS API روی 8728 بدون SSL + SSH</span></div><div class="checkboxes"><label class="check"><input type="checkbox" id="allCities" onchange="toggleCities(this)"> همه شهرها</label>${cities.filter(c=>c.enabled).map(c=>`<label class="check"><input class="cityChk" type="checkbox" value="${c.id}"> ${h(c.name)} <span class="small muted">${h(c.cidr)}</span></label>`).join('')}</div><div class="toolbar" style="margin-top:10px"><button class="btn primary" onclick="startScan()">⚡ شروع اسکن</button><span id="scanMsg" class="status muted">انتخاب شهرها اختیاری است؛ بدون انتخاب = همه شهرهای فعال</span></div></div>`}
function toggleCities(x){document.querySelectorAll('.cityChk').forEach(c=>c.checked=x.checked)}
async function startScan(){const ids=[...document.querySelectorAll('.cityChk:checked')].map(x=>+x.value);try{const r=await api('/api/scan-now',{method:'POST',body:JSON.stringify({city_ids:ids.length?ids:null})});$('scanMsg').innerHTML='<span class="ok">'+h(r.message)+'</span>';poll()}catch(e){alert(e.message)}}
async function poll(){try{const s=await api('/api/scan-status');if(s.running){setTimeout(poll,3000)}else{loadHome()}}catch{}}
async function openCity(id){currentCity=id;app.innerHTML=nav()+`<div class="card"><button class="btn" onclick="loadHome()">بازگشت</button><div id="cityBox" class="loading">در حال دریافت دستگاه‌ها...</div></div>`;try{const c=(await api('/api/cities')).find(x=>x.id===id);const rows=await api('/api/devices?city_id='+id);$('cityBox').innerHTML=`<div class="section-title"><h2>🏙 ${h(c.name)}</h2><span class="muted">${h(c.cidr)}</span></div><div class="toolbar"><input id="citySearch" placeholder="جستجو نام / SSID / مدل / IP"><button class="btn" onclick="filterCity()">جستجو</button><select id="cityWirelessHours"><option value="12">۱۲ ساعت</option><option value="24" selected>۲۴ ساعت</option><option value="36">۳۶ ساعت</option><option value="all">همه</option></select><button class="btn" onclick="exportWirelessCity(currentCity)">📤 خروجی Wireless Excel</button></div><div id="cityTable" class="table" style="margin-top:10px"></div>`;renderDevices(rows,'cityTable')}catch(e){alert(e.message)}}
async function filterCity(){const q=$('citySearch')?.value||'';const rows=await api('/api/devices?city_id='+currentCity+'&q='+encodeURIComponent(q));renderDevices(rows,'cityTable')}
async function exportWirelessCity(cityId){const hours=$('cityWirelessHours')?.value||'all';await fileDownload('/api/excel/wireless?city_id='+encodeURIComponent(cityId)+'&hours='+encodeURIComponent(hours),'wireless_city_'+cityId+'_'+hours+'.xlsx')}
async function exportWirelessDevice(ip){const hours=$('wirelessDeviceHours')?.value||'all';await fileDownload('/api/excel/wireless?ip='+encodeURIComponent(ip)+'&hours='+encodeURIComponent(hours),'wireless_'+ip.replaceAll('.','_')+'_'+hours+'.xlsx')}
function renderDevices(rows,target){const box=$(target);if(!rows.length){box.innerHTML='<div class="notice muted">داده‌ای برای این شهر وجود ندارد.</div>';return}box.innerHTML=`<table><tr><th>IP</th><th>نام</th><th>Type</th><th>SSID</th><th>Frequency</th><th>RX</th><th>TX</th><th>RX Rate</th><th>TX Rate</th><th>CCQ</th><th>Status</th></tr>${rows.map(d=>`<tr><td class="ltr">${h(d.ip_address)}</td><td class="link ltr" onclick="detail('${encodeURIComponent(d.ip_address)}')">${h(d.hostname||d.ip_address)}</td><td>${h(d.device_type)}</td><td class="ltr">${h(d.ssid)}</td><td>${h(d.frequency)}</td><td>${h(d.rx_power)}</td><td>${h(d.peer_tx_signal)}</td><td>${h(d.rx_rate)}</td><td>${h(d.tx_rate)}</td><td>${h(d.ccq)}</td><td>${d.scan_status==='success'?'<span class="ok">آنلاین</span>':'<span class="bad">خطا</span>'}</td></tr>`).join('')}</table>`}
async function detail(ip){try{current=await api('/api/device/'+ip);renderDetail()}catch(e){alert(e.message)}}
function renderDetail(){const d=current||{};const tabs=ME.role==='full'?[['general','اصلی'],['wireless','Wireless'],['antenna','اطلاعات آنتن'],['registration','Registration'],['interfaces','Interfaces'],['queues','Queues'],['firewall','Firewall'],['pppoe','PPPoE/VPN'],['sources','SNMP/API/SSH'],['changes','Changes'],['manual','رادیو دستی'],['raw','Raw']]:[['general','اصلی'],['wireless','Wireless']];app.innerHTML=nav()+`<div class="card"><button class="btn" onclick="${currentCity?'openCity('+currentCity+')':'loadHome()'}">بازگشت</button><h2>${h(d.hostname||d.ip_address)} <span class="muted ltr">${h(d.ip_address)}</span></h2><div class="tabs">${tabs.map((t,i)=>`<button class="tab ${i===0?'active':''}" onclick="detailTab('${t[0]}',this)">${t[1]}</button>`).join('')}</div><div id="detailBody"></div></div>`;detailTab('general',document.querySelector('.tab'))}
function rowsHtml(items){return `<div class="grid">${items.map(x=>`<div class="card"><b>${h(x[0])}</b><div class="${String(x[1]||'').includes('\n')?'raw':''}">${h(x[1]||'-')}</div></div>`).join('')}</div>`}
function detailTab(name,el){document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));if(el)el.classList.add('active');const d=current||{};let rows=[];if(name==='general')rows=[['Vendor',d.vendor],['Model',d.model],['RouterOS',d.routeros_version],['Firmware',d.firmware_version],['Serial',d.serial_number],['MAC',d.mac_address],['Uptime',d.uptime],['City',d.city],['CPU',d.cpu_load],['Memory',d.memory_usage],['Temperature',d.temperature]];if(name==='antenna'){rows=[['Latitude',d.manual_latitude||d.latitude],['Longitude',d.manual_longitude||d.longitude],['Province',d.manual_province||d.province],['City',d.manual_city],['Antenna Gain',d.manual_antenna_gain||d.antenna_gain],['Polarization',d.manual_polarization||d.polarization],['Capacity',d.manual_capacity||d.capacity]]}if(name==='wireless')rows=[['SSID',d.ssid],['Frequency',d.frequency],['Channel',d.channel],['Bandwidth',d.bandwidth],['Mode',d.mode],['Radio',d.radio_name],['Interface',d.interface_name],['Wireless Status',d.wireless_status],['TX Power',d.tx_power],['RX Power',d.rx_power||d.signal_strength],['Signal',d.signal_strength],['Peer TX Signal',d.peer_tx_signal],['TX Rate',d.tx_rate],['RX Rate',d.rx_rate],['CCQ',d.ccq],['TX CCQ',d.tx_ccq],['RX CCQ',d.rx_ccq],['SNR',d.snr],['Noise Floor',d.noise_floor]];if(name==='registration')rows=[['Registration Table',d.wireless_registration]];if(name==='interfaces')rows=[['Interfaces',d.interfaces]];if(name==='queues')rows=[['Queues',d.queues]];if(name==='firewall')rows=[['Firewall counters',d.firewall_counters]];if(name==='pppoe')rows=[['PPPoE / VPN',d.pppoe_vpn],['Routes',d.ip_routes]];if(name==='sources')rows=[['SNMP',d.snmp_status],['RouterOS API',d.api_status],['SSH',d.ssh_status],['Credential',d.credential_id]];if(name==='changes'){api('/api/changes?limit=200').then(x=>{$('detailBody').innerHTML=`<div class="table"><table><tr><th>زمان</th><th>IP</th><th>فیلد</th><th>قدیم</th><th>جدید</th></tr>${x.filter(c=>c.ip_address===d.ip_address).map(c=>`<tr><td>${h(c.changed_at)}</td><td>${h(c.ip_address)}</td><td>${h(c.field_name)}</td><td>${h(c.old_value)}</td><td>${h(c.new_value)}</td></tr>`).join('')}</table></div>`}).catch(e=>alert(e.message));return}if(name==='manual'){const r=d.manual_radio||{};rows=[['IP',r.ip_address],['Name',r.name],['Model',r.model],['Vendor',r.vendor],['SSID',r.ssid],['Frequency',r.frequency],['Channel',r.channel],['Bandwidth',r.bandwidth],['Mode',r.mode],['Radio Name',r.radio_name],['TX Power',r.tx_power],['RX Power',r.rx_power],['Signal',r.signal_strength],['Peer TX Signal',r.peer_tx_signal],['TX Rate',r.tx_rate],['RX Rate',r.rx_rate],['CCQ',r.ccq],['SNR',r.snr],['Noise Floor',r.noise_floor],['Notes',r.notes]]}if(name==='raw'){ $('detailBody').innerHTML=`<div class="raw">${h(d.raw_data||'-')}</div>`;return} $('detailBody').innerHTML=rowsHtml(rows)+ (name==='wireless'?`<div class="toolbar"><select id="wirelessDeviceHours"><option value="12">۱۲ ساعت</option><option value="24" selected>۲۴ ساعت</option><option value="36">۳۶ ساعت</option><option value="all">همه</option></select><button class="btn" onclick="exportWirelessDevice('${encodeURIComponent(d.ip_address)}')">📤 خروجی Wireless Excel</button>${ME.role==='full'?`<button class="btn" onclick="radioScan('${encodeURIComponent(d.ip_address)}')">📡 اجرای Radio Scan دستی</button>`:''}</div>`:'')}
async function radioScan(ip){try{const r=await api('/api/device/'+ip+'/radio-scan',{method:'POST',body:'{}'});alert(r.status==='success'?'Radio Scan انجام شد ✅':JSON.stringify(r));}catch(e){alert(e.message)}}
async function openViewExcel(){app.innerHTML=nav()+`<div class="card"><h2>📊 خروجی Excel</h2><div class="notice">این خروجی شامل اطلاعات قابل مشاهده برای کاربر فعلی است و شامل رمزها یا تنظیمات مدیریتی نیست.</div><div class="toolbar"><select id="viewFullHours"><option value="12">۱۲ ساعت</option><option value="24" selected>۲۴ ساعت</option><option value="36">۳۶ ساعت</option><option value="all">همه</option></select><button class="btn primary" onclick="downloadViewFullExcel()">📥 دریافت Full Excel</button></div></div>`}
async function downloadViewFullExcel(){const hours=$('viewFullHours')?.value||'all';await fileDownload('/api/excel/view-full?hours='+encodeURIComponent(hours),'wireless_monitor_view_'+hours+'h.xlsx')}
function openAdmin(){app.innerHTML=nav()+`<div class="card"><h2>⚙ مدیریت</h2><div class="tabs"><button class="tab active" onclick="adminTab('cities',this)">شهرها / ارتباطات</button><button class="tab" onclick="adminTab('blacklist',this)">Blacklist</button><button class="tab" onclick="adminTab('radios',this)">رادیو دستی</button><button class="tab" onclick="adminTab('manualips',this)">IPهای دستی</button><button class="tab" onclick="adminTab('antenna',this)">اطلاعات آنتن</button><button class="tab" onclick="adminTab('backup',this)">Excel / Backup</button><button class="tab" onclick="adminTab('users',this)">Users</button><button class="tab" onclick="adminTab('history',this)">تاریخچه</button></div><div id="adminBody"></div></div>`;adminTab('cities',document.querySelector('.tab'))}
async function adminTab(name,el){document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));if(el)el.classList.add('active');const b=$('adminBody');if(name==='cities'){const c=await api('/api/cities');b.innerHTML=`<div class="notice">برای هر شهر پورت‌ها و credentialهای مستقل ثبت می‌شوند. همان credentialهای SSH برای RouterOS API Plain نیز استفاده می‌شوند. <b>API-SSL عمداً خاموش است و استفاده نمی‌شود.</b></div><h3>افزودن شهر</h3>${cityForm()}<hr><div class="table"><table><tr><th>شهر</th><th>CIDR</th><th>SSH</th><th>SNMP</th><th>API</th><th>وضعیت</th><th>عملیات</th></tr>${c.map(x=>`<tr><td>${h(x.name)}</td><td class="ltr">${h(x.cidr)}</td><td>${x.ssh_port}</td><td>${x.snmp_port}</td><td>${x.api_enabled?'8728 / بدون SSL':'خاموش'}</td><td>${x.enabled?'فعال':'غیرفعال'}</td><td><button class="btn" onclick="editCity(${x.id})">ویرایش</button> <button class="btn danger" onclick="delCity(${x.id})">حذف</button></td></tr>`).join('')}</table></div>`}if(name==='blacklist'){const x=await api('/api/blacklist');b.innerHTML=`<div class="toolbar"><button class="btn" onclick="fileDownload('/api/excel/blacklist','blacklist.xlsx')">📤 خروجی Excel</button><label class="btn">📥 ورود Excel<input id="blFile" type="file" accept=".xlsx,.xlsm" hidden onchange="importBlack(this)"></label></div><br><div class="form-grid"><input id="be" placeholder="IP یا CIDR"><input id="bd" placeholder="توضیح"><button class="btn danger" onclick="addBL()">افزودن</button></div><div class="table"><table><tr><th>Entry</th><th>Description</th><th>عملیات</th></tr>${x.map(r=>`<tr><td class="ltr">${h(r.entry)}</td><td>${h(r.description)}</td><td><button class="btn" onclick="delBL(${r.id})">حذف</button></td></tr>`).join('')}</table></div>`}if(name==='radios'){const x=await api('/api/manual-radios');b.innerHTML=`<div class="toolbar"><button class="btn" onclick="fileDownload('/api/excel/radios','manual_radios.xlsx')">📤 خروجی Excel</button><label class="btn">📥 ورود Excel<input id="radioFile" type="file" accept=".xlsx,.xlsm" hidden onchange="importRadio(this)"></label></div><br>${radioForm()}<div class="table"><table><tr><th>IP</th><th>Name</th><th>Model</th><th>SSID</th><th>Frequency</th><th>TX</th><th>RX</th><th>عملیات</th></tr>${x.map(r=>`<tr><td class="ltr">${h(r.ip_address)}</td><td>${h(r.name)}</td><td>${h(r.model)}</td><td class="ltr">${h(r.ssid)}</td><td>${h(r.frequency)}</td><td>${h(r.tx_power)}</td><td>${h(r.rx_power)}</td><td><button class="btn" onclick="delRadio(${r.id})">حذف</button></td></tr>`).join('')}</table></div>`}if(name==='manualips'){await loadManualIpsAdmin()}if(name==='antenna'){await loadAntennaAdmin()}if(name==='backup'){b.innerHTML=`<div class="notice">Backup شامل Devices، Cities، Scan History، Scan Targets، Changes، Wireless، Registration، Interfaces، Queues، Firewall، Blacklist، Manual Radios و Manual IPs است.</div><div class="toolbar"><select id="backupHours"><option value="12">۱۲ ساعت</option><option value="24" selected>۲۴ ساعت</option><option value="36">۳۶ ساعت</option><option value="all">همه</option></select><button class="btn primary" onclick="makeBackup()">💾 ساخت Backup فایل</button><button class="btn" onclick="doExport()">📤 Full Export</button><button class="btn" onclick="fileDownload('/api/excel/template','template.xlsx')">📥 قالب دستگاه</button></div><br><div class="toolbar"><select id="interval"><option value="12">Auto Backup هر ۱۲ ساعت</option><option value="24" selected>Auto Backup هر ۲۴ ساعت</option><option value="36">Auto Backup هر ۳۶ ساعت</option></select><button class="btn" onclick="saveInterval()">ثبت زمان Auto Backup</button></div><div id="backups" style="margin-top:10px"></div>`;loadBackups()}if(name==='users'){const u=await api('/api/users');b.innerHTML=`<div class="form-grid"><input id="un" placeholder="username"><input id="up" type="password" placeholder="password"><select id="ur"><option value="view">View</option><option value="full">Full</option></select><button class="btn primary" onclick="addUser()">افزودن</button></div><div class="table"><table><tr><th>User</th><th>Role</th><th>عملیات</th></tr>${u.map(x=>`<tr><td>${h(x.username)}</td><td>${h(x.role)}</td><td><button class="btn" onclick="delUser(${x.id})">حذف</button></td></tr>`).join('')}</table></div>`}if(name==='history'){const x=await api('/api/scan-history?limit=500');b.innerHTML=`<div class="toolbar"><input id="beforeDate" type="datetime-local"><button class="btn danger" onclick="deleteHistory()">🗑 حذف قبل از تاریخ</button><button class="btn" onclick="cleanup24()">پاکسازی قدیمی‌ها</button></div><div class="table" style="margin-top:10px"><table><tr><th>Scan</th><th>زمان</th><th>کل IP</th><th>موفق</th><th>رد</th><th>خطا</th><th>جزئیات</th></tr>${x.map(s=>`<tr><td>#${s.id}</td><td>${h(s.scan_time)}</td><td>${s.total_ips_scanned}</td><td class="ok">${s.devices_success}</td><td>${s.devices_skipped}</td><td class="bad">${s.devices_failed}</td><td><button class="btn" onclick="openScanIPs(${s.id})">IPها</button></td></tr>`).join('')}</table></div>`}}
async function loadManualIpsAdmin(){const [ips,cities]=await Promise.all([api('/api/manual-ips'),api('/api/cities')]);const opts=cities.filter(c=>c.enabled).map(c=>`<option value="${c.id}">${h(c.name)} — ${h(c.cidr)}</option>`).join('');$('adminBody').innerHTML=`<div class="notice">IP دستی را با شهر مربوط ثبت کنید تا از تنظیمات همان شهر برای SNMP/SSH/API استفاده شود.</div><div class="form-grid"><input id="mip" placeholder="IP مثلا 172.17.240.157"><input id="mid" placeholder="توضیح"><select id="mic">${opts}</select><button class="btn primary" onclick="addManualIpAdmin()">افزودن IP</button></div><div class="table"><table><tr><th>IP</th><th>شهر</th><th>توضیح</th><th>وضعیت</th><th>عملیات</th></tr>${ips.map(x=>`<tr><td class="ltr">${h(x.ip_address)}</td><td>${h(x.city_name||'Manual')}</td><td>${h(x.description)}</td><td>${h(x.enabled?'فعال':'غیرفعال')}</td><td><button class="btn danger" onclick="delManualIpAdmin(${x.id})">حذف</button></td></tr>`).join('')}</table></div>`}
async function addManualIpAdmin(){try{await api('/api/manual-ips',{method:'POST',body:JSON.stringify({ip_address:$('mip').value,description:$('mid').value,city_id:$('mic').value})});adminTab('manualips',document.querySelector('.tab'))}catch(e){alert(e.message)}}
async function delManualIpAdmin(id){await api('/api/manual-ips/'+id,{method:'DELETE'});adminTab('manualips',document.querySelector('.tab'))}
async function loadAntennaAdmin(){const cities=await api('/api/cities');const opts=cities.filter(c=>c.enabled).map(c=>`<option value="${c.id}">${h(c.name)} — ${h(c.cidr)}</option>`).join('');$('adminBody').innerHTML=`<div class="notice">شهر را انتخاب کنید، Excel شامل IPهای همان شهر را بگیرید، ستون‌های اطلاعات آنتن را پر کنید و سپس دوباره وارد کنید.</div><div class="toolbar"><select id="antCity">${opts}</select><button class="btn" onclick="exportAntennaAdmin()">📤 خروجی IPهای شهر</button><label class="btn">📥 ورود Excel<input id="antFile" type="file" accept=".xlsx,.xlsm" hidden onchange="importAntennaAdmin(this)"></label></div><div class="notice" style="margin-top:10px"><b>ستون‌ها:</b> IP | Scan City | Latitude | Longitude | Province | City | Antenna Gain | Polarization | Capacity</div>`}
async function exportAntennaAdmin(){const city=$('antCity')?.value||'';await fileDownload('/api/excel/antenna?city_id='+encodeURIComponent(city),'antenna_city_'+city+'.xlsx')}
async function importAntennaAdmin(i){if(!i.files[0])return;const fd=new FormData();fd.append('file',i.files[0]);const r=await fetch(API+'/api/excel/antenna',{method:'POST',headers:{Authorization:AUTH},body:fd});let j={};try{j=await r.json()}catch{}if(!r.ok)throw new Error(j.message||j.error||'Excel import failed');alert('اطلاعات آنتن وارد شد ✅');adminTab('antenna',document.querySelector('.tab'))}

function cityForm(){return `<div class="form-grid"><input id="cn" placeholder="نام شهر مثلا تهران"><input id="cc" placeholder="CIDR مثلا 172.17.240.0/20"><input id="sp" type="number" value="22" placeholder="SSH Port"><input id="np" type="number" value="161" placeholder="SNMP Port"><input id="ap" type="number" value="8728" placeholder="API Port"><input id="st" type="number" step="0.1" value="6" placeholder="SSH Timeout"><input id="nt" type="number" step="0.1" value="2.5" placeholder="SNMP Timeout"><input id="at" type="number" step="0.1" value="4" placeholder="API Timeout"><textarea id="sc" class="wide" rows="4" placeholder='SSH credentials JSON: [{"id":"a","username":"admin","password":"xxx"},{"id":"b","username":"op","password":"yyy"}]'></textarea><textarea id="nc" class="wide" rows="3" placeholder='SNMP communities JSON: ["ngstehwl","public2"]'></textarea><label><input id="ae" type="checkbox" checked> RouterOS API فعال (Plain 8728 فقط)</label><button class="btn primary" onclick="addCity()">افزودن شهر</button></div>`}
async function addCity(){const x=cityPayload();try{await api('/api/cities',{method:'POST',body:JSON.stringify(x)});adminTab('cities',document.querySelector('.tab'))}catch(e){alert(e.message)}}
function cityPayload(){let s=[] ,n=[];try{s=JSON.parse($('sc').value||'[]')}catch{throw new Error('JSON رمزهای SSH نامعتبر است')}try{n=JSON.parse($('nc').value||'[]')}catch{throw new Error('JSON Communityهای SNMP نامعتبر است')}return {name:$('cn').value,cidr:$('cc').value,ssh_port:+$('sp').value,snmp_port:+$('np').value,api_port:+$('ap').value,ssh_timeout:+$('st').value,snmp_timeout:+$('nt').value,api_timeout:+$('at').value,api_enabled:$('ae').checked?1:0,ssh_credentials:s,snmp_communities:n,enabled:1}}
async function editCity(id){const x=(await api('/api/cities')).find(c=>c.id===id);if(!x)return;const name=prompt('نام شهر',x.name);if(name===null)return;const cidr=prompt('CIDR',x.cidr);if(cidr===null)return;const sshPort=prompt('SSH Port',x.ssh_port);if(sshPort===null)return;const snmpPort=prompt('SNMP Port',x.snmp_port);if(snmpPort===null)return;const apiPort=prompt('RouterOS API Port (plain, no SSL)',x.api_port);if(apiPort===null)return;try{const s=JSON.parse(prompt('SSH credentials JSON',x.ssh_credentials_json||'[]'));const n=JSON.parse(prompt('SNMP communities JSON',x.snmp_communities_json||'[]'));await api('/api/cities/'+id,{method:'PUT',body:JSON.stringify({...x,name,cidr,ssh_port:+sshPort,snmp_port:+snmpPort,api_port:+apiPort,api_ssl_enabled:0,ssh_credentials:s,snmp_communities:n})});openAdmin()}catch(e){alert(e.message)}}
async function delCity(id){if(!confirm('شهر حذف شود؟'))return;await api('/api/cities/'+id,{method:'DELETE'});openAdmin()}
async function addBL(){try{await api('/api/blacklist',{method:'POST',body:JSON.stringify({entry:$('be').value,description:$('bd').value})});adminTab('blacklist',document.querySelector('.tab'))}catch(e){alert(e.message)}}async function delBL(id){await api('/api/blacklist/'+id,{method:'DELETE'});adminTab('blacklist',document.querySelector('.tab'))}
async function importBlack(i){if(!i.files[0])return;const fd=new FormData();fd.append('file',i.files[0]);await fetch(API+'/api/excel/blacklist',{method:'POST',headers:{Authorization:AUTH},body:fd});adminTab('blacklist',document.querySelector('.tab'))}
function radioForm(){return `<div class="card manual"><h3>رادیو دستی</h3><div class="form-grid">${['ip_address','name','model','vendor','serial_number','ssid','frequency','channel','bandwidth','mode','radio_name','tx_power','rx_power','signal_strength','peer_tx_signal','tx_rate','rx_rate','ccq','snr','noise_floor','notes'].map(f=>`<input id="r_${f}" placeholder="${f.replaceAll('_',' ')}">`).join('')}<button class="btn primary wide" onclick="addRadio()">ذخیره رادیو</button></div></div>`}
async function addRadio(){const x={};document.querySelectorAll('[id^="r_"]').forEach(e=>x[e.id.slice(2)]=e.value);try{await api('/api/manual-radios',{method:'POST',body:JSON.stringify(x)});adminTab('radios',document.querySelector('.tab'))}catch(e){alert(e.message)}}async function delRadio(id){await api('/api/manual-radios/'+id,{method:'DELETE'});adminTab('radios',document.querySelector('.tab'))}async function importRadio(i){if(!i.files[0])return;const fd=new FormData();fd.append('file',i.files[0]);await fetch(API+'/api/excel/radios',{method:'POST',headers:{Authorization:AUTH},body:fd});adminTab('radios',document.querySelector('.tab'))}
async function doExport(){const hours=$('backupHours').value;await fileDownload('/api/excel/export?hours='+encodeURIComponent(hours),`wireless_monitor_${hours}.xlsx`)}async function makeBackup(){const h2=$('backupHours').value==='all'?24:+$('backupHours').value;const r=await api('/api/backup',{method:'POST',body:JSON.stringify({hours:h2})});loadBackups();alert('Backup ساخته شد: '+r.name)}async function loadBackups(){try{const x=await api('/api/backup/list');$('backups').innerHTML='<div class="table"><table><tr><th>File</th><th>Size</th><th>Download</th></tr>'+x.map(p=>`<tr><td class="ltr">${h(p.name)}</td><td>${(p.size/1024).toFixed(1)} KB</td><td><button class="btn" onclick="fileDownload('/api/backup/file/${encodeURIComponent(p.name)}','${p.name}')">دریافت</button></td></tr>`).join('')+'</table></div>'}catch{}}async function saveInterval(){await api('/api/settings/backup-interval',{method:'POST',body:JSON.stringify({hours:+$('interval').value})});alert('ثبت شد')}async function addUser(){try{await api('/api/users',{method:'POST',body:JSON.stringify({username:$('un').value,password:$('up').value,role:$('ur').value})});adminTab('users',document.querySelector('.tab'))}catch(e){alert(e.message)}}async function delUser(id){await api('/api/users/'+id,{method:'DELETE'});adminTab('users',document.querySelector('.tab'))}
async function deleteHistory(){const x=$('beforeDate').value;if(!x)return alert('تاریخ را انتخاب کنید');await api('/api/history?before='+encodeURIComponent(x.replace('T',' ')),{method:'DELETE'});adminTab('history',document.querySelector('.tab'))}async function cleanup24(){await api('/api/history/cleanup',{method:'POST',body:'{}'});adminTab('history',document.querySelector('.tab'))}
async function openScanIPs(id){if(!id)return alert('هنوز اسکن ثبت نشده');const x=await api('/api/scan/'+id);app.innerHTML=nav()+`<div class="card"><button class="btn" onclick="loadHome()">بازگشت</button><h2>📋 IPهای اسکن شده — Scan #${id}</h2><div class="muted">${h(x.scan.scan_time)} | کل: ${x.scan.total_ips_scanned} | موفق: ${x.scan.devices_success} | رد: ${x.scan.devices_skipped} | خطا: ${x.scan.devices_failed}</div></div><div class="card"><div class="table"><table><tr><th>IP</th><th>شهر</th><th>وضعیت</th><th>مرحله</th><th>علت</th><th>داده</th></tr>${x.results.map(r=>`<tr><td class="ltr">${h(r.ip_address)}</td><td>${h(r.city_name)}</td><td>${r.status==='success'?'<span class="ok">success</span>':r.status==='not_alive'?'<span class="warn">not_alive</span>':r.status==='blacklisted'?'<span class="bad">blacklisted</span>':'<span class="bad">'+h(r.status)+'</span>'}</td><td>${h(r.stage)}</td><td>${h(r.reason)}</td><td><button class="btn" onclick='showSnapshot(${JSON.stringify(JSON.stringify(r.snapshot||{}))})'>Snapshot</button></td></tr>`).join('')}</table></div></div>`}
function showSnapshot(e){let x={};try{x=JSON.parse(e)}catch{x={raw:e}}app.innerHTML=nav()+`<div class="card"><button class="btn" onclick="loadHome()">بازگشت</button><h2>Snapshot</h2><div class="raw">${h(JSON.stringify(x,null,2))}</div></div>`}
login();
</script></body></html>
